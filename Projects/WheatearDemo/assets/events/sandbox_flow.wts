# Wheatear vertical slice flow controller.
# This script is attached to FlowController entities in vertical-slice scenes.

event on_start:
end

event menu_new_game:
    newgame:assets/scenes/Intro.wt
end

event menu_load_game:
    gamesave:open_load_menu
end

event menu_quit:
    quit
end

event go_main_menu:
    scene:assets/scenes/VisualNovelMainMenu.wt
end

event go_intro:
    scene:assets/scenes/Intro.wt
end

event go_fake_combat:
    progression:set_flag:FLAG_CH01_FAKE_COMBAT_STARTED
    scene:assets/scenes/VisualNovelBattle.wt
end

event fake_combat_victory:
    progression:set_flag:FLAG_CH01_FAKE_COMBAT_CLEARED
    wait 0.10
    scene:assets/scenes/TurnCombat.wt
end

event turn_combat_victory:
    progression:set_flag:FLAG_CH01_TURN_COMBAT_CLEARED
    wait 0.10
    scene:assets/scenes/PostFake.wt
end

event turn_combat_retry:
    scene:assets/scenes/TurnCombat.wt
end

event go_side_combat:
    progression:set_active_dungeon:CH02_MAIN_BearAwakening
    scene:assets/scenes/SideCombatBeastPath.wt
end

event go_tactical_combat:
    scene:assets/scenes/TacticalCombat.wt
end

event tactical_combat_victory:
    progression:set_flag:FLAG_CH01_TACTICAL_COMBAT_CLEARED
    wait 0.10
    scene:assets/scenes/Hub.wt
end

event tactical_combat_retry:
    scene:assets/scenes/TacticalCombat.wt
end

event tutorial_side_combat_start:
    progression:set_flag:FLAG_CH02_TUTORIAL_STARTED
    progression:set_active_dungeon:CH02_MAIN_BearAwakening
    scene:assets/scenes/SideCombatBeastPath.wt
end

event go_beast_path:
    progression:set_active_dungeon:CH02_MAT_BeastPath
    scene:assets/scenes/SideCombatBeastPath.wt
end

event side_combat_victory:
    if last_dungeon CH02_MAIN_BearAwakening
        progression:set_flag:FLAG_CH02_TUTORIAL_CLEARED
    endif
    wait 0.10
    scene:assets/scenes/Result.wt
end

event side_combat_retry:
    scene:assets/scenes/SideCombatBeastPath.wt
end

event beast_path_victory:
    event:side_combat_victory
end

event beast_path_retry:
    progression:set_active_dungeon:CH02_MAT_BeastPath
    event:side_combat_retry
end

event go_hub:
    scene:assets/scenes/Hub.wt
end

event go_hub_save:
    wait 0.05
    scene:assets/scenes/Hub.wt
end

event result_go_hub:
    wait 0.05
    scene:assets/scenes/Hub.wt
end

event result_retry_last_dungeon:
    if last_dungeon CH02_MAIN_BearAwakening
        progression:set_active_dungeon:CH02_MAIN_BearAwakening
        scene:assets/scenes/SideCombatBeastPath.wt
    endif
    if last_dungeon CH02_MAT_BeastPath
        progression:set_active_dungeon:CH02_MAT_BeastPath
        scene:assets/scenes/SideCombatBeastPath.wt
    endif
end

event go_dungeon_select:
    scene:assets/scenes/DungeonSelect.wt
end

event go_skill_tree:
    scene:assets/scenes/SkillTree.wt
end

event go_equipment:
    scene:assets/scenes/Equipment.wt
end

event go_relationship:
    scene:assets/scenes/Relationship.wt
end

event go_support:
    scene:assets/scenes/Support.wt
end

event go_save_load:
    gamesave:open_save_menu
end

event go_load_save:
    gamesave:open_load_menu
end

event go_settings:
    scene:assets/scenes/Settings.wt
end

event go_chapter3_preview:
    scene:assets/scenes/Chapter3Preview.wt
end

event go_next_story:
    if flag FLAG_CH02_BOSS_DEFEATED
        progression:set_flag:FLAG_CH03_PREVIEW_STARTED
        progression:set_chapter:3
        scene:assets/scenes/Chapter3Preview.wt
    endif
end

event route_after_result:
    if flag FLAG_HUB_UNLOCKED
        event:result_go_hub
    endif
end

event save_slot_1:
    gamesave:slot_save_1
end

event load_slot_1:
    gamesave:load_1
end

event save_slot_1_then_hub:
    gamesave:slot_save_1
    wait 0.05
    scene:assets/scenes/Hub.wt
end

event load_slot_1_then_intro:
    loadgame:assets/scenes/Intro.wt:1
end
